{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": [
      "ESNext",
      "DOM"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "packages/**/*",
    "docs/**/*",
    "*.ts",
    "*.d.ts",
    "env.d.ts",
    "*.js"
  ],
  // Both packages type-check through their own tooling, invoked from the root
  // `lint` script: svelte-check for @urcolor/svelte, `tsc -p tsconfig.lib.json`
  // for @urcolor/angular. vue-tsc cannot resolve `.svelte` named type exports
  // (it falls back to a generic `*.svelte` module shim), and Angular needs
  // ngtsc rather than plain tsc.
  "exclude": [
    "packages/svelte",
    "packages/angular",
    "node_modules",
    "**/dist"
  ]
}