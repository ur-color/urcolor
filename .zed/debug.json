// Zed debug configurations — mirrors .vscode/launch.json
[
  {
    "label": "Docs (VitePress)",
    "adapter": "JavaScript",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT/docs",
    "runtimeExecutable": "bun",
    "runtimeArgs": ["run", "dev"],
    "console": "integratedTerminal",
    "skipFiles": ["<node_internals>/**"]
  },
  {
    "label": "Docs (VitePress) — preview built site",
    "adapter": "JavaScript",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT/docs",
    "runtimeExecutable": "bun",
    "runtimeArgs": ["run", "preview"],
    "console": "integratedTerminal",
    "skipFiles": ["<node_internals>/**"]
  },
  {
    "label": "Storybook (Vue)",
    "adapter": "JavaScript",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT/packages/vue",
    "runtimeExecutable": "bun",
    "runtimeArgs": ["run", "storybook", "--ci"],
    "console": "integratedTerminal",
    "skipFiles": ["<node_internals>/**"]
  },
  {
    "label": "Storybook (React)",
    "adapter": "JavaScript",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT/packages/react",
    "runtimeExecutable": "bun",
    "runtimeArgs": ["run", "storybook", "--ci"],
    "console": "integratedTerminal",
    "skipFiles": ["<node_internals>/**"]
  },
  {
    "label": "Bun test (all)",
    "adapter": "JavaScript",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "runtimeExecutable": "bun",
    "runtimeArgs": ["test"],
    "console": "integratedTerminal",
    "skipFiles": ["<node_internals>/**"]
  },
  {
    "label": "Bun test (current file)",
    "adapter": "JavaScript",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "runtimeExecutable": "bun",
    "runtimeArgs": ["test", "$ZED_FILE"],
    "console": "integratedTerminal",
    "skipFiles": ["<node_internals>/**"]
  }
]
