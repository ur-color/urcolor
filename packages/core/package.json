{
  "name": "@urcolor/core",
  "version": "2.0.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "bench": "bun run bench/index.ts",
    "bench:report": "bun run bench/report.ts --json",
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts --outdir ./dist --format esm",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist --project tsconfig.build.json"
  },
  "keywords": [
    "color",
    "color-picker",
    "color-space",
    "hsl",
    "oklch",
    "oklab",
    "display-p3",
    "color-conversion"
  ],
  "author": {
    "name": "GrandMagus",
    "url": "https://github.com/GrandMagus02"
  },
  "homepage": "https://urcolor.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ur-color/urcolor",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ur-color/urcolor/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@ctrl/tinycolor": "^4.2.0",
    "@types/chroma-js": "^3.1.2",
    "@types/culori": "^4.0.1",
    "@types/tinycolor2": "^1.4.6",
    "@urcolor/shared": "workspace:*",
    "chroma-js": "^3.2.0",
    "colord": "^2.9.3",
    "colorjs.io": "^0.7.1",
    "culori": "^4.0.2",
    "mitata": "^1.0.34",
    "tinycolor2": "^1.6.0"
  }
}